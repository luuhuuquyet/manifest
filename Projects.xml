    <project name="camera-projects/rpi-camera/vchiq_interface"
             path="projects/camera-projects/camera-projects/rpi-camera/vchiq_interface" />

    <project name="camera-projects/rpi-camera/vcsm"
             path="projects/camera-projects/camera-projects/rpi-camera/vcsm" />

    <project name="camera-projects/rpi-camera/vcsm_interface"
             path="projects/camera-projects/camera-projects/rpi-camera/vcsm_interface" />
</manifest>
